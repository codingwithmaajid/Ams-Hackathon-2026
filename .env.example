# Copy to .env for local development. Never commit real values.
APP_ENV=local
APP_NAME=Jolly
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Bolna voice layer — https://platform.bolna.ai
BOLNA_API_KEY=
BOLNA_BASE_URL=https://api.bolna.ai
# UUID of the Jolly agent you created in the Bolna dashboard
BOLNA_AGENT_ID=
# Optional: a number bought in your Bolna account (E.164). Omit to use the default.
BOLNA_FROM_NUMBER=
# Optional: shared secret appended as ?secret=... to the webhook and tool URLs in Bolna
BOLNA_WEBHOOK_SECRET=

# Coming next (Milestone 2+)
LLM_API_KEY=
EMBEDDING_API_KEY=
DATABASE_URL=
